# Required for real answers (not needed for --dry-run). Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional settings (defaults shown)
FAQBOT_BUSINESS_NAME=Sunrise Bakery
FAQBOT_DOCS_DIR=sample_docs
FAQBOT_MODEL=claude-haiku-5-5
FAQBOT_MAX_TOKENS=4096
FAQBOT_TOP_K=4
FAQBOT_CHUNK_CHARS=900
# Set to true to force dry-run in the web app even when a key is present
FAQBOT_DRY_RUN=false
